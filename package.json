{
  "name": "yimly-ha-map",
  "version": "1.0.0",
  "description": "Home Assistant Lovelace custom card for live family location tracking with directional edge markers",
  "author": "Yimly (https://github.com/yimlyapp)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yimlyapp/yimly-ha-map.git"
  },
  "main": "dist/yimly-ha-map.js",
  "module": "dist/yimly-ha-map.js",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build:card": "vite build --config vite.card.config.ts",
    "build": "vite build && vite build --config vite.card.config.ts && esbuild server.ts --platform=node --format=esm --target=node22 --outfile=server.js --bundle --packages=external",
    "start": "node server.js",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "home-assistant-js-websocket": "^9.7.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  }
}
